# Neon connection string (Neon console → Connect → "Pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Any long random string: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"
# Optional, local dev only: point the Neon driver at a local Neon-compatible HTTP
# proxy instead of Neon's servers. When set, both the app and `npm run db:migrate`
# use it, so DATABASE_URL names the database inside the proxy.
# NEON_FETCH_ENDPOINT="http://localhost:4444/sql"
